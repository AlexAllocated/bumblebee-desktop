    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "customConditions": []
  },
  "include": [
    "src/index.ts",
    "src/low-level.ts",
    "src/speech-assets.ts",
    "src/tools.ts",
    "src/timeline.ts",
    "src/frameRenderer.ts",
    "src/**/*.d.ts"
  ]
}
