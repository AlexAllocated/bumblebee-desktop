{
  "name": "@hivetech/speech-bubbles",
  "version": "0.0.4",
  "description": "Framework-free SVG speech bubble renderer with timed word reveal and subject-aware placement.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexAllocated/bumblebee-desktop.git",
    "directory": "packages/speech-bubbles"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./types": {
      "development": "./src/types.ts",
      "types": "./dist/types.d.ts"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "development": "./src/style.css",
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./reveal": {
      "development": "./src/reveal.ts",
      "types": "./dist/reveal.d.ts",
      "import": "./dist/reveal.js"
    },
    "./style": {
      "development": "./src/style.ts",
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check .",
    "prepack": "bun run build",
    "test": "bun --conditions=development test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^7.2.2"
  },
  "license": "MIT"
}
